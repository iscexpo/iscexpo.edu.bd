{
  "name": "iscexpo",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "db:seed": "node --experimental-strip-types scripts/seed-demo-admin.ts",
    "db:seed:isc": "tsx scripts/seed-isc-curriculum.ts",
    "db:seed:isc:dry": "tsx scripts/seed-isc-curriculum.ts --dry-run",
    "db:reset:isc": "node --experimental-strip-types scripts/clean-db.ts && node --experimental-strip-types scripts/seed-demo-admin.ts && tsx scripts/seed-isc-curriculum.ts",
    "db:clean": "node --experimental-strip-types scripts/clean-db.ts",
    "db:reset": "node --experimental-strip-types scripts/clean-db.ts && node --experimental-strip-types scripts/seed-demo-admin.ts",
    "db:migrate": "drizzle-kit push",
    "db:analyze": "node --experimental-strip-types scripts/analyze-db.ts",
    "i18n:check": "node --experimental-strip-types scripts/check-i18n.ts",
    "db:verify": "node --experimental-strip-types scripts/verify-migrations.ts",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/drizzle-adapter": "^1.7.6",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "1.6.1",
    "@vercel/blob": "^2.8.0",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-intl": "^4.14.7",
    "postgres": "^3.4.9",
    "react": "^19",
    "react-dom": "^19",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vercel": "^55.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "1.6.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-plugin-storybook": "^10.6.0",
    "jsdom": "^22.1.0",
    "postcss": "^8.5",
    "prettier": "^3.9.9",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.1",
    "vitest": "^1.0.0"
  },
  "overrides": {
    "hono": "4.12.25"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
